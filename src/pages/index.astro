        --accent: #4f9de0;
        --accent-ink: #08121c;

        --st-pendiente: #9aa0ab;
        --st-planeada: #eab234;
        --st-planeada-ink: #f0be4e;
        --st-en_curso: #4f9de0;
        --st-completada: #35c07f;

        --wire-prereq: #eab234;
        --wire-unlock: #35c07f;
        --wire-idle: #565d68;
        --wire-r: #ec5555;
        --wire-g: #35c07f;
        --wire-b: #c3c9d2;
        --wire-p: #e765a8;
        --wire-o: #f6883a;
        --wire-halo: #0c0d11;

        --surface-2: #232833;
        --track-bg: #262b35;
        --plan-bg: #1c212a;
        --plan-ink: #e6e8ec;
        --done-mix: #151920;
        --chip: #1f242e; /* superficie base de tarjeta, claramente sobre el fondo */
