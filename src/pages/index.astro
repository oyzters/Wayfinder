        /* Superficies derivadas (grafito redefine) */
        --surface-2: #f7f8fa; /* botones/celdas suaves */
        --track-bg: #e9ebf0; /* pista de barra de progreso */
        --plan-bg: #ffffff; /* fondo de tarjeta "planeada" */
        --plan-ink: #2a2f37;
        --done-mix: #eceef1; /* base de mezcla "completada" */
        --wire-halo: #ffffff; /* contorno de flechas */
        --brand-badge-bg: #1b1e24; /* insignia ISW / sem-heads / botones oscuros */
      }

      /* ================= MODO OSCURO — slate ================= */
      /* ===================================================================
         MODO OSCURO — SLATE.
         Superficies neutras de grafito, alto contraste sin estridencias.
         Las tarjetas NO se rellenan de color: son chips oscuros con una
         BARRA lateral + TÍTULO teñidos con el color del bloque. Para que el
         tablero se lea como UN SOLO sistema, los colores de bloque están
         DESATURADOS y nivelados a una misma luminosidad (nada de neón). Un
         único acento — azul sereno — gobierna la UI. Estética Linear/Vercel.
         --cd = color del bloque (barra/título); --chip = superficie base.
         =================================================================== */
      :root[data-theme="dark"] {
        --bg: #0b0d11;
        --panel: #161a21;
        --ink-1: #e6e8ec;
        --ink-2: #8b929e;
